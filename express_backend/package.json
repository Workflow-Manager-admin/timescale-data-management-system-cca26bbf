{
    "name": "minimal-express-app",
    "version": "1.0.0",
    "description": "Minimal Express app with scalable structure",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "build": "tsc && npm run copy-non-ts",
        "copy-non-ts": "cp -r src/routes dist/routes && cp -r src/controllers dist/controllers && cp -r src/services dist/services && cp -r src/middleware dist/middleware",
        "dev": "ts-node src/server.ts",
        "dev:watch": "nodemon --watch src --ext ts,js,json --exec ts-node src/server.ts",
        "test": "jest",
        "lint": "eslint .",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.21.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.23",
        "@types/node": "^20.19.7",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^9.24.0",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "nodemonConfig": {
        "watch": [
            "src"
        ],
        "ignore": [
            "node_modules",
            "package.json",
            "package-lock.json",
            "*.lock",
            "*.log",
            "*.md",
            ".git",
            "dist",
            "build"
        ],
        "ext": "ts,js,json"
    }
}
