{
    "name": "minimal-express-app",
    "version": "1.0.0",
    "description": "Minimal Express app with scalable structure",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "build": "tsc",
        "dev": "ts-node src/server.ts",
        "dev:watch": "nodemon --watch src --ext ts,js,json --exec ts-node src/server.ts",
        "test": "jest",
        "lint": "eslint .",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio"
    },
    "dependencies": {
        "cors": "2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "@prisma/client": "^5.13.0"
    },
    "devDependencies": {
        "eslint": "^9.24.0",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "typescript": "^5.4.5",
        "ts-node": "^10.9.2",
        "@types/node": "^20.11.30",
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17"
    },
    "nodemonConfig": {
        "watch": ["src"],
        "ignore": [
            "node_modules",
            "package.json",
            "package-lock.json",
            "*.lock",
            "*.log",
            "*.md",
            ".git",
            "dist",
            "build"
        ],
        "ext": "ts,js,json"
    }
}
